<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.academictracker.controller.AdminDashboardController">
    
    <!-- Top Menu Bar -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Refresh" onAction="#handleRefresh"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Logout" onAction="#handleLogout"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About"/>
                </Menu>
            </MenuBar>
            
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
                <Label fx:id="welcomeLabel" text="Welcome, Admin" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
            </HBox>
        </VBox>
    </top>
    
    <!-- Center Content -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            
            <!-- Students Tab -->
            <Tab text="Students">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                         <Button text="Add Student" styleClass="primary-button" onAction="#handleAddStudent"/>
                        <Button text="Edit Student" styleClass="secondary-button" onAction="#handleEditStudent"/>
                        <Button text="Delete Student" styleClass="danger-button" onAction="#handleDeleteStudent"/>
                        <Button text="View Details" onAction="#handleViewStudentDetails"/>
                        <Button fx:id="evaluateRisksButton" text="Evaluar riesgos" onAction="#handleEvaluateRisks" />
                    </HBox>
                    
                    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="studentIdColumn" text="Code" prefWidth="80"/>
                            <TableColumn fx:id="studentFirstNameColumn" text="Names" prefWidth="120"/>
                            <TableColumn fx:id="studentLastNameColumn" text="Last Names" prefWidth="120"/>
                            <TableColumn fx:id="studentDocumentColumn" text="Document" prefWidth="100"/>
                            <TableColumn fx:id="studentEmailColumn" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="studentProgramColumn" text="Program" prefWidth="180"/>
                            <TableColumn fx:id="studentSedeColumn" text="Sede" prefWidth="120"/>
                            <TableColumn fx:id="studentRiesgoColumn" text="Risk" prefWidth="60"/>
                        </columns>
                        <placeholder>
                            <Label text="No students found. Click 'Add Student' to add a new student." style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Teachers Tab -->
            <Tab text="Teachers">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Teacher" styleClass="primary-button" onAction="#handleAddTeacher"/>
                        <Button text="Edit Teacher" styleClass="secondary-button" onAction="#handleEditTeacher"/>
                        <Button text="Delete Teacher" styleClass="danger-button" onAction="#handleDeleteTeacher"/>
                        <Button text="View Details" onAction="#handleViewTeacherDetails"/>
                    </HBox>
                    
                    <TableView fx:id="teacherTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="teacherIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="teacherFirstNameColumn" text="First Name" prefWidth="150"/>
                            <TableColumn fx:id="teacherLastNameColumn" text="Last Name" prefWidth="150"/>
                            <TableColumn fx:id="teacherDepartmentColumn" text="Department" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Programs Tab -->
            <Tab text="Programs">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Program" styleClass="primary-button" onAction="#handleAddProgram"/>
                        <Button text="Edit Program" styleClass="secondary-button" onAction="#handleEditProgram"/>
                        <Button text="Delete Program" styleClass="danger-button" onAction="#handleDeleteProgram"/>
                        <Button text="View Details" onAction="#handleViewProgramDetails"/>
                    </HBox>
                    
                    <TableView fx:id="programTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="programIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="programCodeColumn" text="Code" prefWidth="100"/>
                            <TableColumn fx:id="programNameColumn" text="Name" prefWidth="250"/>
                            <TableColumn fx:id="programDurationColumn" text="Duration (Years)" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Courses Tab -->
            <Tab text="Courses">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Course" styleClass="primary-button"/>
                        <Button text="Edit Course" styleClass="secondary-button"/>
                        <Button text="Delete Course" styleClass="danger-button"/>
                        <Button text="Assign Teacher" onAction="#handleAssignTeacher"/>
                    </HBox>
                    
                    <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="courseIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="courseCodeColumn" text="Code" prefWidth="100"/>
                            <TableColumn fx:id="courseNameColumn" text="Name" prefWidth="250"/>
                            <TableColumn fx:id="courseCreditsColumn" text="Credits" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Groups Tab -->
            <Tab text="Groups">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Group" styleClass="primary-button" onAction="#handleAddGroup"/>
                        <Button text="Edit Group" styleClass="secondary-button" onAction="#handleEditGroup"/>
                        <Button text="Delete Group" styleClass="danger-button" onAction="#handleDeleteGroup"/>
                        <Button text="View Details" onAction="#handleViewGroupDetails"/>
                    </HBox>

                    <TableView fx:id="groupTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="groupIdColumn" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="groupNumberColumn" text="Group #" prefWidth="80"/>
                            <TableColumn fx:id="groupCourseColumn" text="Course" prefWidth="200"/>
                            <TableColumn fx:id="groupPeriodColumn" text="Period" prefWidth="120"/>
                            <TableColumn fx:id="groupSedeColumn" text="Sede" prefWidth="120"/>
                            <TableColumn fx:id="groupCapacityColumn" text="Capacity" prefWidth="100"/>
                            <TableColumn fx:id="groupEnrolledColumn" text="Enrolled" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No groups found. Click 'Add Group' to create a new group." style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Enrollments Tab -->
            <Tab text="Enrollments">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="New Enrollment" styleClass="primary-button"/>
                        <Button text="View Details"/>
                        <Button text="Update Status"/>
                    </HBox>
                    
                    <Label text="Enrollment management will be displayed here" style="-fx-font-size: 16px; -fx-padding: 20;"/>
                </VBox>
            </Tab>
            
            <!-- Matriculas Tab -->
            <Tab text="Matriculas">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Create Matricula" styleClass="primary-button" onAction="#handleCreateMatricula"/>
                        <Button text="Edit Matricula" styleClass="secondary-button" onAction="#handleEditMatricula"/>
                        <Button text="Delete Matricula" styleClass="danger-button" onAction="#handleDeleteMatricula"/>
                        <Button text="View Details" onAction="#handleViewMatriculaDetails"/>
                    </HBox>

                    <TableView fx:id="matriculaTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="matriculaIdColumn" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="matriculaStudentColumn" text="Student Code" prefWidth="120"/>
                            <TableColumn fx:id="matriculaStudentNameColumn" text="Student Name" prefWidth="200"/>
                            <TableColumn fx:id="matriculaPeriodColumn" text="Period" prefWidth="120"/>
                            <TableColumn fx:id="matriculaDateColumn" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="matriculaCreditsColumn" text="Credits" prefWidth="80"/>
                            <TableColumn fx:id="matriculaStatusColumn" text="Status" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="No matriculas found. Click 'Create Matricula' to add a new matricula." style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Users Tab -->
            <Tab text="User Management">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Activate Account" styleClass="primary-button" onAction="#handleActivateAccount"/>
                        <Button text="View Details" onAction="#handleViewAccountDetails"/>
                        <Button text="Refresh" styleClass="secondary-button" onAction="#handleRefresh"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Logout" styleClass="danger-button" onAction="#handleLogout"/>
                    </HBox>

                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userTypeColumn" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="userRefColumn" text="ID" prefWidth="120"/>
                            <TableColumn fx:id="userNameColumn" text="Name" prefWidth="200"/>
                            <TableColumn fx:id="userEmailColumn" text="Email" prefWidth="220"/>
                            <TableColumn fx:id="userStatusColumn" text="Account Status" prefWidth="140"/>
                        </columns>
                        <placeholder>
                            <Label text="No students or teachers found." style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
            
        </TabPane>
    </center>
    
    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
            <Label text="Academic Tracker Software v1.0.0"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Database: Connected"/>
        </HBox>
    </bottom>
    
</BorderPane>
