<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.academictracker.controller.StudentDashboardController">
    
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="Actualizar" onAction="#handleRefresh"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Cerrar Sesión" onAction="#handleLogout"/>
                </Menu>
            </MenuBar>
            
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #3498db; -fx-padding: 15;">
                <Label fx:id="welcomeLabel" text="Bienvenido, Estudiante" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="programaLabel" text="Programa: -" textFill="WHITE">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="periodoLabel" text="Período: -" textFill="WHITE">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <!-- Tab: Mis Cursos Inscritos -->
            <Tab text="Mis Cursos">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Mis Cursos Inscritos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalCreditosLabel" text="Créditos: 0" style="-fx-font-size: 14px;"/>
                        <Button text="Actualizar" onAction="#loadEnrolledCourses" styleClass="btn-primary"/>
                    </HBox>

                    <TableView fx:id="enrolledCoursesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCodAsignatura" text="Código" prefWidth="100"/>
                            <TableColumn fx:id="colNombreAsignatura" text="Asignatura" prefWidth="250"/>
                            <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="80"/>
                            <TableColumn fx:id="colCreditos" text="Créditos" prefWidth="80"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                            <TableColumn fx:id="colFechaInscripcion" text="Fecha Inscripción" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button text="Cancelar Inscripción" onAction="#handleCancelEnrollment"
                                styleClass="btn-danger" disable="true" fx:id="btnCancelEnrollment"/>
                    </HBox>
                </VBox>
            </Tab>
            
            <!-- Tab: Inscripción a Cursos -->
            <Tab text="Inscripción">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="Inscripción a Grupos de Materias" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Filtrar por semestre:"/>
                        <ComboBox fx:id="semestreComboBox" promptText="Todos" prefWidth="150"
                                  onAction="#handleFilterBySemester"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ver Todos los Grupos" onAction="#loadAvailableGroups" styleClass="btn-primary"/>
                    </HBox>

                    <TableView fx:id="availableGroupsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAvailCodAsignatura" text="Código" prefWidth="100"/>
                            <TableColumn fx:id="colAvailNombreAsignatura" text="Asignatura" prefWidth="250"/>
                            <TableColumn fx:id="colAvailGrupo" text="Grupo" prefWidth="80"/>
                            <TableColumn fx:id="colAvailCreditos" text="Créditos" prefWidth="80"/>
                            <TableColumn fx:id="colAvailSemestre" text="Semestre" prefWidth="80"/>
                            <TableColumn fx:id="colAvailCupos" text="Cupos Disp." prefWidth="100"/>
                            <TableColumn fx:id="colAvailSede" text="Sede" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button text="Inscribir en Grupo Seleccionado" onAction="#handleEnrollInGroup"
                                styleClass="btn-success" disable="true" fx:id="btnEnrollInGroup"/>
                        <Label fx:id="enrollmentMessageLabel" text="" style="-fx-text-fill: green;"/>
                    </HBox>
                </VBox>
            </Tab>
            
            <!-- Tab: Mis Calificaciones -->
            <Tab text="Mis Calificaciones">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Mis Calificaciones" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="promedioLabel" text="Promedio: -" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="gradesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colGradeCodAsignatura" text="Código" prefWidth="100"/>
                            <TableColumn fx:id="colGradeNombreAsignatura" text="Asignatura" prefWidth="250"/>
                            <TableColumn fx:id="colGradeGrupo" text="Grupo" prefWidth="80"/>
                            <TableColumn fx:id="colGradeCreditos" text="Créditos" prefWidth="80"/>
                            <TableColumn fx:id="colNotaDefinitiva" text="Nota Final" prefWidth="100"/>
                            <TableColumn fx:id="colGradeEstado" text="Estado" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
